# Copy to .env for local development (never commit your real .env).
# Canvas → Account → Settings → "+ New Access Token". Set an expiration date.
CANVAS_API_TOKEN=your-canvas-token-here
# Your Canvas host, no scheme or trailing slash.
CANVAS_DOMAIN=school.instructure.com

# --- Optional: remote / LAN (HTTP) mode. Default transport is stdio. ---
# See README "Remote / LAN (HTTP) mode". Uncomment to serve over HTTP.
# MCP_TRANSPORT=http
# MCP_HTTP_HOST=0.0.0.0        # 0.0.0.0 = LAN-reachable; 127.0.0.1 = local only (default)
# MCP_HTTP_PORT=7356
# MCP_AUTH_TOKEN=              # required in http mode: the Bearer token clients must present

