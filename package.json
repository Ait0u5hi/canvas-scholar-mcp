{
  "name": "canvas-scholar-mcp",
  "version": "0.1.0",
  "description": "A student-focused Canvas LMS MCP server: check your assignments, grades, discussions, missing work, and planner from any MCP client. Read-only, local, privacy-preserving.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "canvas",
    "canvas-lms",
    "lms",
    "student",
    "assignments",
    "grades",
    "instructure",
    "claude"
  ],
  "homepage": "https://github.com/Ait0u5hi/canvas-scholar-mcp#readme",
  "bugs": {
    "url": "https://github.com/Ait0u5hi/canvas-scholar-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ait0u5hi/canvas-scholar-mcp.git"
  },
  "license": "MIT",
  "author": "Ait0u5hi",
  "type": "module",
  "bin": {
    "canvas-scholar-mcp": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
